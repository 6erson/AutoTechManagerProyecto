"Mecanicos" [label=<<TABLE WIDTH="210" BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b5c2d0"><TR><TD BGCOLOR="#244b71"><FONT COLOR="white"><B>Mecanicos</B></FONT></TD></TR><TR><TD ALIGN="LEFT">int MecanicoId PK</TD></TR><TR><TD ALIGN="LEFT">string Nombre</TD></TR><TR><TD ALIGN="LEFT">string Especialidad</TD></TR><TR><TD ALIGN="LEFT">bit Activo</TD></TR></TABLE>>];
"Proveedores" [label=<<TABLE WIDTH="210" BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b5c2d0"><TR><TD BGCOLOR="#244b71"><FONT COLOR="white"><B>Proveedores</B></FONT></TD></TR><TR><TD ALIGN="LEFT">int ProveedorId PK</TD></TR><TR><TD ALIGN="LEFT">string Nombre</TD></TR><TR><TD ALIGN="LEFT">string Telefono</TD></TR><TR><TD ALIGN="LEFT">bit Activo</TD></TR></TABLE>>];
"Repuestos" [label=<<TABLE WIDTH="210" BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b5c2d0"><TR><TD BGCOLOR="#244b71"><FONT COLOR="white"><B>Repuestos</B></FONT></TD></TR><TR><TD ALIGN="LEFT">int RepuestoId PK</TD></TR><TR><TD ALIGN="LEFT">int ProveedorId FK</TD></TR><TR><TD ALIGN="LEFT">string Codigo UK</TD></TR><TR><TD ALIGN="LEFT">string Nombre</TD></TR><TR><TD ALIGN="LEFT">int Stock</TD></TR><TR><TD ALIGN="LEFT">int Minimo</TD></TR><TR><TD ALIGN="LEFT">decimal Costo</TD></TR><TR><TD ALIGN="LEFT">decimal Precio</TD></TR><TR><TD ALIGN="LEFT">bit Activo</TD></TR></TABLE>>];
"ServicioRepuesto" [label=<<TABLE WIDTH="210" BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b5c2d0"><TR><TD BGCOLOR="#244b71"><FONT COLOR="white"><B>ServicioRepuesto</B></FONT></TD></TR><TR><TD ALIGN="LEFT">int ServicioId PK,FK</TD></TR><TR><TD ALIGN="LEFT">int RepuestoId PK,FK</TD></TR><TR><TD ALIGN="LEFT">int Cantidad</TD></TR></TABLE>>];
"OrdenesTrabajo" [label=<<TABLE WIDTH="210" BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b5c2d0"><TR><TD BGCOLOR="#244b71"><FONT COLOR="white"><B>OrdenesTrabajo</B></FONT></TD></TR><TR><TD ALIGN="LEFT">int OrdenId PK</TD></TR><TR><TD ALIGN="LEFT">int ClienteId FK</TD></TR><TR><TD ALIGN="LEFT">int VehiculoId FK</TD></TR><TR><TD ALIGN="LEFT">int ResponsableId FK</TD></TR><TR><TD ALIGN="LEFT">datetime Fecha</TD></TR><TR><TD ALIGN="LEFT">int Kilometraje</TD></TR><TR><TD ALIGN="LEFT">string Sintomas</TD></TR><TR><TD ALIGN="LEFT">string Estado</TD></TR><TR><TD ALIGN="LEFT">datetime FechaEntrega</TD></TR></TABLE>>];
