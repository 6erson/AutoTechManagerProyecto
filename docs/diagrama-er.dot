"OrdenesTrabajo" -> "ControlesCalidad" [arrowhead=crow,taillabel="1",headlabel="1..N" label="verifica"];
"Repuestos" -> "Motores" [arrowhead=crow,taillabel="1",headlabel="0..N" label="identifica"];
