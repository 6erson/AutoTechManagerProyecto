"OrdenesTrabajo" -> "MovimientosInventario" [arrowhead=crow,taillabel="0..1",headlabel="0..N" label="registra"];
"Repuestos" -> "MovimientosInventario" [arrowhead=crow,taillabel="1",headlabel="0..N" label="mueve"];
"OrdenesTrabajo" -> "Pagos" [arrowhead=crow,taillabel="1",headlabel="0..N" label="recibe"];
