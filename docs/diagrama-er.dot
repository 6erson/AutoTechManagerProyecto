"DetalleOrden" [label=<<TABLE WIDTH="210" BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b5c2d0"><TR><TD BGCOLOR="#244b71"><FONT COLOR="white"><B>DetalleOrden</B></FONT></TD></TR><TR><TD ALIGN="LEFT">int DetalleId PK</TD></TR><TR><TD ALIGN="LEFT">int OrdenId FK</TD></TR><TR><TD ALIGN="LEFT">int ServicioId FK</TD></TR><TR><TD ALIGN="LEFT">string Nombre</TD></TR><TR><TD ALIGN="LEFT">int Nivel</TD></TR><TR><TD ALIGN="LEFT">decimal Horas</TD></TR><TR><TD ALIGN="LEFT">decimal Importe</TD></TR></TABLE>>];
"Diagnosticos" [label=<<TABLE WIDTH="210" BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b5c2d0"><TR><TD BGCOLOR="#244b71"><FONT COLOR="white"><B>Diagnosticos</B></FONT></TD></TR><TR><TD ALIGN="LEFT">int DiagnosticoId PK</TD></TR><TR><TD ALIGN="LEFT">int OrdenId FK,UK</TD></TR><TR><TD ALIGN="LEFT">string Evaluacion</TD></TR><TR><TD ALIGN="LEFT">string Evidencias</TD></TR><TR><TD ALIGN="LEFT">datetime Fecha</TD></TR></TABLE>>];
"ConsumosOrden" [label=<<TABLE WIDTH="210" BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b5c2d0"><TR><TD BGCOLOR="#244b71"><FONT COLOR="white"><B>ConsumosOrden</B></FONT></TD></TR><TR><TD ALIGN="LEFT">int ConsumoId PK</TD></TR><TR><TD ALIGN="LEFT">int OrdenId FK</TD></TR><TR><TD ALIGN="LEFT">int RepuestoId FK</TD></TR><TR><TD ALIGN="LEFT">int Cantidad</TD></TR><TR><TD ALIGN="LEFT">decimal Precio</TD></TR><TR><TD ALIGN="LEFT">bit Procesado</TD></TR></TABLE>>];
