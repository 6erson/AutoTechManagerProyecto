"ControlesCalidad" [label=<<TABLE WIDTH="210" BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b5c2d0"><TR><TD BGCOLOR="#244b71"><FONT COLOR="white"><B>ControlesCalidad</B></FONT></TD></TR><TR><TD ALIGN="LEFT">int ControlId PK</TD></TR><TR><TD ALIGN="LEFT">int OrdenId FK</TD></TR><TR><TD ALIGN="LEFT">string Descripcion</TD></TR><TR><TD ALIGN="LEFT">bit Obligatorio</TD></TR><TR><TD ALIGN="LEFT">bit Aprobado</TD></TR><TR><TD ALIGN="LEFT">string Resultado</TD></TR></TABLE>>];
"AuditoriaOrdenes" [label=<<TABLE WIDTH="210" BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b5c2d0"><TR><TD BGCOLOR="#244b71"><FONT COLOR="white"><B>AuditoriaOrdenes</B></FONT></TD></TR><TR><TD ALIGN="LEFT">int AuditoriaId PK</TD></TR><TR><TD ALIGN="LEFT">int OrdenId</TD></TR><TR><TD ALIGN="LEFT">string EstadoAnterior</TD></TR><TR><TD ALIGN="LEFT">string EstadoNuevo</TD></TR><TR><TD ALIGN="LEFT">datetime Fecha</TD></TR><TR><TD ALIGN="LEFT">string Usuario</TD></TR></TABLE>>];
"Clientes" -> "Vehiculos" [arrowhead=crow,taillabel="1",headlabel="0..N" label="posee"];
"Clientes" -> "OrdenesTrabajo" [arrowhead=crow,taillabel="1",headlabel="0..N" label="solicita"];
"Vehiculos" -> "OrdenesTrabajo" [arrowhead=crow,taillabel="1",headlabel="0..N" label="ingresa"];
"Mecanicos" -> "OrdenesTrabajo" [arrowhead=crow,taillabel="1",headlabel="0..N" label="responsable"];
"OrdenesTrabajo" -> "OrdenMecanicos" [arrowhead=crow,taillabel="1",headlabel="1..N" label="asigna"];
"Mecanicos" -> "OrdenMecanicos" [arrowhead=crow,taillabel="1",headlabel="0..N" label="participa"];
"OrdenesTrabajo" -> "DetalleOrden" [arrowhead=crow,taillabel="1",headlabel="0..N" label="incluye"];
"Servicios" -> "DetalleOrden" [arrowhead=crow,taillabel="1",headlabel="0..N" label="origina"];
