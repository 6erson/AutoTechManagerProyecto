"OrdenesTrabajo" -> "Diagnosticos" [arrowhead=vee,taillabel="1",headlabel="0..1" label="evalua"];
"OrdenesTrabajo" -> "Presupuestos" [arrowhead=vee,taillabel="1",headlabel="0..1" label="cotiza"];
