"Presupuestos" [label=<<TABLE WIDTH="210" BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b5c2d0"><TR><TD BGCOLOR="#244b71"><FONT COLOR="white"><B>Presupuestos</B></FONT></TD></TR><TR><TD ALIGN="LEFT">int PresupuestoId PK</TD></TR><TR><TD ALIGN="LEFT">int OrdenId FK,UK</TD></TR><TR><TD ALIGN="LEFT">decimal ManoObra</TD></TR><TR><TD ALIGN="LEFT">decimal Repuestos</TD></TR><TR><TD ALIGN="LEFT">decimal Descuento</TD></TR><TR><TD ALIGN="LEFT">string AutorizoDescuento</TD></TR><TR><TD ALIGN="LEFT">decimal Impuesto</TD></TR><TR><TD ALIGN="LEFT">decimal Total</TD></TR><TR><TD ALIGN="LEFT">string Decision</TD></TR><TR><TD ALIGN="LEFT">string Autorizacion</TD></TR></TABLE>>];
"Pagos" [label=<<TABLE WIDTH="210" BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b5c2d0"><TR><TD BGCOLOR="#244b71"><FONT COLOR="white"><B>Pagos</B></FONT></TD></TR><TR><TD ALIGN="LEFT">int PagoId PK</TD></TR><TR><TD ALIGN="LEFT">int OrdenId FK</TD></TR><TR><TD ALIGN="LEFT">datetime Fecha</TD></TR><TR><TD ALIGN="LEFT">decimal Monto</TD></TR><TR><TD ALIGN="LEFT">string Metodo</TD></TR><TR><TD ALIGN="LEFT">string Referencia</TD></TR></TABLE>>];
"Motores" [label=<<TABLE WIDTH="210" BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b5c2d0"><TR><TD BGCOLOR="#244b71"><FONT COLOR="white"><B>Motores</B></FONT></TD></TR><TR><TD ALIGN="LEFT">int MotorId PK</TD></TR><TR><TD ALIGN="LEFT">int RepuestoId FK</TD></TR><TR><TD ALIGN="LEFT">string Serie UK</TD></TR><TR><TD ALIGN="LEFT">string Marca</TD></TR><TR><TD ALIGN="LEFT">string Modelo</TD></TR><TR><TD ALIGN="LEFT">int AnioDesde</TD></TR><TR><TD ALIGN="LEFT">int AnioHasta</TD></TR><TR><TD ALIGN="LEFT">string Combustible</TD></TR><TR><TD ALIGN="LEFT">string Estado</TD></TR></TABLE>>];
