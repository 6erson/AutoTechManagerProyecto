digraph G {
 graph [rankdir=TB,bgcolor="#ffffff",pad=0.35,nodesep=0.35,ranksep=0.9,splines=polyline,fontname="Arial",label="AutoTech Manager | Diagrama entidad-relacion",labelloc=t,fontsize=24];
 node [shape=plain,fontname="Arial",fontsize=11];
 edge [color="#6c8299",fontname="Arial",fontsize=9,arrowsize=0.65];
"Clientes" [label=<<TABLE WIDTH="210" BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b5c2d0"><TR><TD BGCOLOR="#244b71"><FONT COLOR="white"><B>Clientes</B></FONT></TD></TR><TR><TD ALIGN="LEFT">int ClienteId PK</TD></TR><TR><TD ALIGN="LEFT">string Nombre</TD></TR><TR><TD ALIGN="LEFT">string Telefono</TD></TR><TR><TD ALIGN="LEFT">string Correo</TD></TR><TR><TD ALIGN="LEFT">bit Activo</TD></TR></TABLE>>];
"Vehiculos" [label=<<TABLE WIDTH="210" BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b5c2d0"><TR><TD BGCOLOR="#244b71"><FONT COLOR="white"><B>Vehiculos</B></FONT></TD></TR><TR><TD ALIGN="LEFT">int VehiculoId PK</TD></TR><TR><TD ALIGN="LEFT">int ClienteId FK</TD></TR><TR><TD ALIGN="LEFT">string Placa UK</TD></TR><TR><TD ALIGN="LEFT">string VIN UK</TD></TR><TR><TD ALIGN="LEFT">string Marca</TD></TR><TR><TD ALIGN="LEFT">string Modelo</TD></TR><TR><TD ALIGN="LEFT">int Anio</TD></TR><TR><TD ALIGN="LEFT">string Color</TD></TR><TR><TD ALIGN="LEFT">int Kilometraje</TD></TR><TR><TD ALIGN="LEFT">string Combustible</TD></TR></TABLE>>];
