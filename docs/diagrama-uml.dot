digraph G {
 graph [rankdir=TB,bgcolor="white",pad=0.4,nodesep=0.4,ranksep=0.8,fontname="Arial",label="AutoTech Manager | UML de clases",labelloc=t,fontsize=24];
 node [shape=record,fontname="Arial",fontsize=11,style=filled,fillcolor="#edf3f9",color="#496987",margin=0.15];
 edge [color="#657e96",fontname="Arial",fontsize=10];
 AutoTechManager [label="{AutoTechManager|+ main(args): void}"];
 FrmPrincipal [label="{FrmPrincipal|+ FrmPrincipal()}"];
 PanelSistema [label="{PanelSistema|Navegacion por pestanas}"];
 PanelTaller [label="{PanelTaller|Clientes y vehiculos}"];
 PanelCatalogos [label="{PanelCatalogos|Servicios, personal e inventario}"];
 PanelOrdenes [label="{PanelOrdenes|Ordenes, presupuestos y pagos}"];
 PanelReportes [label="{PanelReportes|Reportes e historial}"];
 TallerService [label="{TallerService|+ crearOrden(...): int\l+ diagnostico(...): void\l+ agregarServicio(...): void\l+ presupuesto(...): BigDecimal\l+ decidir(...): void\l+ reservarMotor(...): void\l+ consumir(...): void\l+ estado(...): void\l+ pagar(...): void\l+ comprobante(...): String\l}"];
 Sql [label="{Sql|+ consultar(...): Tabla\l+ ejecutar(...): int\l+ insertar(...): int\l}"];
 ConexionDB [label="{ConexionDB|+ getConexion(): Connection}"];
 Repositorio [label="{«interface» Repositorio T|+ listar(): List T\l+ guardar(entidad): void\l}"];
 ClienteDAO [label="{ClienteDAO|+ listar(): List Cliente\l+ guardar(cliente): void\l+ desactivar(id): void\l}"];
 VehiculoDAO [label="{VehiculoDAO|+ listar(): List Vehiculo\l+ guardar(vehiculo): void\l}"];
 Servicio [label="{«abstract» Servicio|+ nombre(): String\l+ costoManoObra(): BigDecimal\l+ requisitoEntrega(): String (abstracto)\l+ crear(...): Servicio (estatico)\l}"];
 ServicioGeneral [label="{ServicioGeneral|+ requisitoEntrega(): String}"];
 ServicioMayor [label="{ServicioMayor|+ requisitoEntrega(): String}"];
 Modelos [label="{«records»|Cliente\lVehiculo\lMecanico\lOrdenTrabajo\l}"];
 AutoTechManager -> FrmPrincipal;
 FrmPrincipal -> PanelSistema [dir=both,arrowtail=diamond,arrowhead=none];
 PanelSistema -> {PanelTaller PanelCatalogos PanelOrdenes PanelReportes} [dir=both,arrowtail=diamond,arrowhead=none];
 {PanelCatalogos PanelOrdenes PanelReportes} -> TallerService;
 PanelTaller -> {ClienteDAO VehiculoDAO};
 {ClienteDAO VehiculoDAO} -> Repositorio [style=dashed,arrowhead=empty,label="implementa"];
 {ClienteDAO VehiculoDAO TallerService} -> ConexionDB;
 TallerService -> {Sql Servicio Modelos};
 ClienteDAO -> Modelos;
 VehiculoDAO -> Modelos;
 {ServicioGeneral ServicioMayor} -> Servicio [arrowhead=empty,label="hereda"];
}